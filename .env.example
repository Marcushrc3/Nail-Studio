# ============================================================
# Nail Studio Manager — variáveis de ambiente (exemplo)
# Copie este arquivo para `.env` e ajuste os valores.
# NUNCA versione o `.env` nem inclua segredos reais aqui.
# ============================================================

# --- Backend (FastAPI) ---

# Obrigatória. URL de conexão do PostgreSQL (driver psycopg v3).
# Em produção, use senha forte e nunca a senha abaixo.
DATABASE_URL=postgresql+psycopg://nail_studio:nail_studio@localhost:5432/nail_studio

# Obrigatória. Segredo usado para assinar os access tokens (HS256).
# Em produção, gere um valor aleatório longo (ex.: `uv run python -c "import secrets; print(secrets.token_urlsafe(64))"`).
JWT_SECRET_KEY=dev-only-insecure-secret-change-in-production

# Duração do access token, em minutos (decisão aprovada: curta duração).
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Origens permitidas pelo CORS (separadas por vírgula).
CORS_ORIGINS=http://localhost:5173

ENVIRONMENT=development

# --- Frontend (Vite) ---

# URL da API usada pelo frontend em desenvolvimento.
VITE_API_URL=http://localhost:8000

# --- Docker Compose (PostgreSQL de desenvolvimento) ---
POSTGRES_USER=nail_studio
POSTGRES_PASSWORD=nail_studio
POSTGRES_DB=nail_studio
