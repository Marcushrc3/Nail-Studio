# ============================================================
# Nail Studio Manager — variáveis de ambiente (exemplo)
# Copie este arquivo para `.env` e ajuste os valores.
# NUNCA versione o `.env` nem inclua segredos reais aqui.
# ============================================================

# --- Backend (FastAPI) ---

# Obrigatória. URL de conexão do PostgreSQL (driver psycopg v3).
# Em produção, use senha forte e nunca a senha abaixo.
DATABASE_URL=postgresql+psycopg://nail_studio:nail_studio@localhost:5432/nail_studio

# Obrigatória. Segredo usado para assinar os access tokens (HS256).
# Em produção, gere um valor aleatório longo (ex.: `uv run python -c "import secrets; print(secrets.token_urlsafe(64))"`).
JWT_SECRET_KEY=dev-only-insecure-secret-change-in-production

# Duração do access token, em minutos (decisão aprovada: curta duração).
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Sessões e verificação (decisões aprovadas D2).
REFRESH_TOKEN_EXPIRE_DAYS=30
VERIFICATION_TOKEN_EXPIRE_MINUTES=1440

# JWT: emissor e audiência (claims iss/aud validadas no backend).
JWT_ISSUER=nail-studio-api
JWT_AUDIENCE=nail-studio-web

# Versões vigentes de Termos e Política de Privacidade (aceite versionado).
TERMS_VERSION=termos-v1
PRIVACY_VERSION=privacidade-v1

# URL do frontend usada nos links dos e-mails de verificação.
FRONTEND_URL=http://localhost:5173

# E-mail: fake em dev/testes (nenhum envio real); smtp entra na E1.4.
EMAIL_PROVIDER=fake

# Origens permitidas pelo CORS (separadas por vírgula).
CORS_ORIGINS=http://localhost:5173

ENVIRONMENT=development

# --- Roles do banco (dev). Em produção, senhas fortes via segredos. ---
# Runtime: a API usa APENAS esta role (sem superuser/BYPASSRLS).
RUNTIME_DATABASE_URL=postgresql+psycopg://app_runtime:app_runtime_pw@localhost:5432/nail_studio
# Migrações: o Alembic usa APENAS esta role (dona dos objetos).
MIGRATION_DATABASE_URL=postgresql+psycopg://app_migration:app_migration_pw@localhost:5432/nail_studio
# Bootstrap de roles e testes de migrations exigem superusuário (uma única vez).
# Docker Compose: superusuário é nail_studio. PostgreSQL portátil local: use postgres.
BOOTSTRAP_DATABASE_URL=postgresql+psycopg://nail_studio:nail_studio@localhost:5432/nail_studio
TEST_ADMIN_DATABASE_URL=postgresql+psycopg://nail_studio:nail_studio@localhost:5432/nail_studio

# --- Frontend (Vite) ---

# URL da API usada pelo frontend em desenvolvimento.
VITE_API_URL=http://localhost:8000

# --- Docker Compose (PostgreSQL de desenvolvimento) ---
POSTGRES_USER=nail_studio
POSTGRES_PASSWORD=nail_studio
POSTGRES_DB=nail_studio
